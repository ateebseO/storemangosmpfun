# These are set in Netlify (Site configuration > Environment variables). NEVER commit real values to GitHub.
TURSO_DATABASE_URL=libsql://your-database-name-yourname.turso.io
TURSO_AUTH_TOKEN=paste-turso-token
ADMIN_PASSWORD=at-least-12-characters-for-the-admin-panel
SESSION_SECRET=48-random-letters-and-digits-at-least-32
STATS_API_KEY=48-random-letters-and-digits-different-from-above
DISCORD_CLIENT_ID=from-discord-developer-portal
DISCORD_CLIENT_SECRET=from-discord-developer-portal
SITE_URL=https://yoursite.netlify.app

# Optional
STATS_API_KEY_NEXT=second-key-only-while-rotating-the-plugin-key
ADMIN_DISCORD_IDS=111111111111111111,222222222222222222
